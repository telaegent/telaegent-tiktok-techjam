{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "publicSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "nextAction": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "const": "relay_suggest_resolution"
                },
                "arguments": {
                  "type": "object",
                  "properties": {
                    "coordinationRequestId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "conflictingIntentIds": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                        },
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                        }
                      ]
                    },
                    "proposalVersion": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "ownership": {
                      "minItems": 2,
                      "maxItems": 2,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ownerId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                          },
                          "agentId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                          },
                          "files": {
                            "maxItems": 20,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            }
                          },
                          "interfaces": {
                            "maxItems": 20,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          }
                        },
                        "required": [
                          "ownerId",
                          "agentId",
                          "files",
                          "interfaces"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "dependencyLinks": {
                      "maxItems": 20,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "consumerIntentId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                          },
                          "providerIntentId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                          },
                          "interface": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          }
                        },
                        "required": [
                          "consumerIntentId",
                          "providerIntentId",
                          "interface"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "requiredRules": {
                      "minItems": 1,
                      "maxItems": 12,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      }
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "coordinationRequestId",
                    "conflictingIntentIds",
                    "proposalVersion",
                    "ownership",
                    "dependencyLinks",
                    "requiredRules",
                    "rationale"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "arguments"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "const": "relay_request_human_decision"
                },
                "arguments": {
                  "type": "object",
                  "properties": {
                    "reasonCode": {
                      "type": "string",
                      "enum": [
                        "SOURCE_ACCESS_REQUIRED",
                        "DUAL_COMMITMENT_REQUIRED",
                        "AFFECTED_PLAN_APPROVAL_REQUIRED",
                        "STALE_STATUS",
                        "AMBIGUOUS_RESOLUTION",
                        "EXCHANGE_LIMIT_REACHED"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "options": {
                      "minItems": 2,
                      "maxItems": 4,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "safeDescription": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 500
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "safeDescription"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "reasonCode",
                    "reason",
                    "options"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "arguments"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "taskState": {
      "type": "string",
      "enum": [
        "working",
        "blocked",
        "completed"
      ]
    }
  },
  "required": [
    "publicSummary",
    "nextAction",
    "taskState"
  ],
  "additionalProperties": false,
  "$id": "urn:telagent:output-schema:resolution:v1",
  "title": "Telagent Resolution Agent Output v1"
}
