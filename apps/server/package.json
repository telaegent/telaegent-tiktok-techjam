{
  "name": "@launchpad/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "demo:relay": "tsx src/dev/mock-agent-relay.ts",
    "demo:connections": "tsx src/dev/probe-provider-connections.ts",
    "demo:session-recovery": "tsx src/dev/prove-provider-session-recovery.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "eval": "tsx src/telagent/protocol/eval/cli.ts",
    "eval:fake": "tsx src/telagent/protocol/eval/cli.ts --runner fake",
    "eval:claude": "tsx src/telagent/protocol/eval/cli.ts --runner claude",
    "eval:codex": "tsx src/telagent/protocol/eval/cli.ts --runner codex"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "fastify": "^5.6.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
