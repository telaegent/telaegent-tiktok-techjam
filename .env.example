# Telaegent cloud control plane
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token
ENABLE_LEGACY_LOCAL_PLAYGROUND=0

# Supabase authorization persistence (backend only). Use a modern
# `sb_secret_...` key for SUPABASE_SECRET_KEY. Never place this key in a
# VITE-prefixed variable or commit a real value. `memory` is a fail-closed
# local default; deployments must opt in explicitly after migrations exist.
AUTHORIZATION_PERSISTENCE=memory
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-backend-secret-key

# Browser-safe Supabase configuration belongs in apps/web/.env.local. Only a
# publishable `sb_publishable_...` key may be exposed through Vite.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-a-publishable-key

# Browser-safe identifiers for the currently bound project conversation.
# These are not authorization credentials. The server must derive the user
# identity from its authenticated session and authorize every operation.
VITE_TELAEGENT_CONVERSATION_ID=00000000-0000-4000-8000-000000000000
VITE_TELAEGENT_GITHUB_REPOSITORY_ID=123456789
# Optional until the API exposes /api/me; used only to align your own approved
# messages on the right side of the conversation.
VITE_TELAEGENT_CURRENT_USER_ID=

# Legacy Starter Kit baseline only. Canonical Telaegent provider turns do not
# use ModelArk. Keep these unset unless deliberately running the old Playground.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=replace-with-your-model-or-endpoint-id
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Local connector / inherited local-adapter development only. Do not set these
# in the Telaegent cloud deployment. Repositories, CLI homes, provider
# credentials, and sessions remain on the developer machine.
APP_DATA_DIR=.data
AGENT_WORKSPACE_ROOT=workspaces
CODEX_HOME=codex-home
CODEX_BIN=codex
# Optional for trusted automation. Otherwise authenticate the isolated
# CODEX_HOME once with `codex login`; never commit its auth.json.
# CODEX_API_KEY=

# Optional connector-side local container isolation. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
# Provider output refreshes this idle clock; total turn limits never reset.
RUNTIME_IDLE_TIMEOUT_MS=60000
CODEX_TIMEOUT_MS=300000
CODEX_MAX_OUTPUT_BYTES=2097152

# Optional Claude Code adapter. Leave these unset to use an existing Claude
# Code login. CLAUDE_API_KEY is mapped to ANTHROPIC_API_KEY only in the child
# process and must never be committed.
CLAUDE_BIN=claude
CLAUDE_TIMEOUT_MS=300000
CLAUDE_MAX_OUTPUT_BYTES=2097152
# CLAUDE_API_KEY=
# CLAUDE_BASE_URL=
# CLAUDE_MODEL=

# Duy-owned purpose schemas are resolved by safe file name from this directory.
RUNTIME_OUTPUT_SCHEMA_ROOT=apps/server/src/telagent/output-schemas

# Local connector adapter only. The cloud Docker/Compose image contains no
# provider CLI and leaves ENABLE_LEGACY_LOCAL_PLAYGROUND=0.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
