# Loaded only by connector commands. Never place this bearer in the root .env.
TELAEGENT_URL=http://localhost:3000
# `npm run setup` replaces this with a stable random local installation ID.
TELAEGENT_CONNECTOR_INSTANCE_ID=replace-with-16-plus-random-url-safe-characters
# Paste the one-time credential shown by the browser. Never commit this file.
TELAEGENT_CONNECTOR_CREDENTIAL=
