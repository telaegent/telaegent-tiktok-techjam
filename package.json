{
  "name": "telaegent-tiktok-techjam",
  "version": "1.0.0",
  "private": true,
  "description": "Telagent messaging and trust infrastructure for independently owned coding Agents.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check --skip-external",
    "doctor": "node scripts/setup.mjs --check --strict-e2e",
    "doctor:live": "npm run connector:connect -- connect --probe-only",
    "up": "node scripts/setup.mjs --start",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dev.mjs",
    "demo:relay": "npm run demo:relay -w @launchpad/server",
    "demo:connections": "npm run demo:connections -w @launchpad/server",
    "demo:session-recovery": "npm run demo:session-recovery -w @launchpad/server",
    "smoke:authorization:supabase": "npm run smoke:authorization:supabase -w @launchpad/server",
    "connector:connect": "npm run build -w @launchpad/server && node --env-file-if-exists=.env --env-file-if-exists=connector.env apps/server/dist/connectors/cli.js",
    "connector:package": "npm run build -w @telaegent/connector",
    "build": "npm run build -w @launchpad/web && npm run build -w @launchpad/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:setup": "node --test scripts/setup-core.test.mjs scripts/process-tree.test.mjs scripts/local-development-security.test.mjs",
    "test": "npm run test:setup && npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run build",
    "poc": "npm run up",
    "legacy:poc": "bash ./scripts/start-local-poc.sh",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/start.mjs",
    "test:protocol": "npm run test -w @launchpad/server -- src/telagent/protocol",
    "eval:fake": "npm run eval:fake -w @launchpad/server --",
    "eval:claude": "npm run eval:claude -w @launchpad/server --",
    "eval:codex": "npm run eval:codex -w @launchpad/server --",
    "eval:deepseek": "npm run eval:deepseek -w @launchpad/server --"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
