{
  "name": "telaegent-tiktok-techjam",
  "version": "1.0.0",
  "private": true,
  "description": "Telagent messaging and trust infrastructure for independently owned coding Agents.",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w @launchpad/server\" \"npm run dev -w @launchpad/web\"",
    "demo:relay": "npm run demo:relay -w @launchpad/server",
    "demo:connections": "npm run demo:connections -w @launchpad/server",
    "demo:session-recovery": "npm run demo:session-recovery -w @launchpad/server",
    "smoke:authorization:supabase": "npm run smoke:authorization:supabase -w @launchpad/server",
    "connector:connect": "npm run connector:connect -w @launchpad/server --",
    "build": "npm run build -w @launchpad/web && npm run build -w @launchpad/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @launchpad/server",
    "check": "npm run typecheck && npm run test && npm run build",
    "poc": "./scripts/start-local-poc.sh",
    "start": "npm run start -w @launchpad/server",
    "test:protocol": "npm run test -w @launchpad/server -- src/telagent/protocol",
    "eval:fake": "npm run eval:fake -w @launchpad/server --",
    "eval:claude": "npm run eval:claude -w @launchpad/server --",
    "eval:codex": "npm run eval:codex -w @launchpad/server --",
    "eval:deepseek": "npm run eval:deepseek -w @launchpad/server --"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
